{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_id", "plan_id", "resume_at", "updated_at"],
  "anyOf": [
    {"required": ["branch_outcomes"]},
    {"required": ["ref_outcomes"]}
  ],
  "properties": {
    "schema_version": {"enum": ["isomer-topic-git-publication-outcomes.v1", "isomer-topic-git-publication-outcomes.v2"]},
    "binding_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "branch_outcomes": {"type": "array", "items": {"type": "object"}},
    "ref_outcomes": {"type": "array", "items": {"type": "object"}},
    "observed_remote_head": {"type": ["string", "null"]},
    "provider_default_branch_action_required": {"type": "boolean"},
    "resume_at": {"type": ["string", "null"]},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
